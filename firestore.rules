rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organizations: allow read for members, create for authenticated users,
    // update/delete only by existing members (ideally owners). This rule
    // assumes organizations doc may have either:
    // - `members` array of uids (existing code), and/or
    // - `members/{uid}` subcollection documents (optional future model).
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if request.auth != null && request.resource.data.get('members', null) is list && request.resource.data.members.hasAny([request.auth.uid]);
      allow update, delete: if isOrgMember(orgId);

      // Allow reading membership subdocs if member
      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgMember(orgId);
      }
    }

    // Venues: creating one needs no permission beyond being signed in — the
    // real app never sets `orgId` on a venue at all (confirmed: it does not
    // appear anywhere in core/src), so requiring `orgId is string` and org
    // membership here, as this rule did until now, made venue creation
    // impossible for every real user the moment these rules were actually
    // deployed to production (they never had been before). The one thing
    // required is that you can only create a venue naming yourself as its
    // owner, not someone else. Reading a venue requires being signed in and
    // having one of the access paths the app itself offers (see
    // isVenueVisibleToUser). Only the venue's creator or a site admin can
    // update, share, or delete it; org membership alone is not enough (a
    // non-admin org member should not be able to edit or delete another
    // member's venue). Admins may update/delete any venue (also needed to
    // wipe a deleted user's data from Profile > Admin > Manage
    // Administrator Access).
    match /venues/{venueId} {
      allow read: if isVenueVisibleToUser();
      allow create: if request.auth != null && request.resource.data.get('userId', null) == request.auth.uid;
      allow update, delete: if isVenueOwner() || isRequestingUserAdmin();
    }

    // Events: same reasoning as venues above — the app never sets `orgId`
    // on an event either, so requiring it on create made event creation
    // impossible too. Creating one just requires being signed in and
    // naming yourself as the owner. Admins may also update/delete any event
    // (see venues comment above).
    //
    // Update is intentionally broader than delete: dispatching a show *is*
    // writing to the event doc (assigning teams, changing call status,
    // posting equipment, etc.), so anyone the app actually lets into the
    // dispatch view — the owner, a user in `sharedWith`, or any member when
    // the event is flagged `isOrgEvent` — needs write access too, not just
    // read. Without this, the dispatch page's client-side check (which
    // already accounts for sharedWith/isOrgEvent) would let a member in but
    // every dispatch action would then fail with permission-denied.
    //
    // That broad grant is field-limited for a non-owner, non-admin writer
    // (a shared user or an org member riding `isOrgEvent`): they can touch
    // ordinary dispatch fields, but not `userId`, `sharedWith`, `isOrgEvent`,
    // `ended`, or `endedAt` (see isEventProtectedFieldsUnchanged) — those
    // control who owns, can see, or can end the event, and none of them are
    // ever legitimately written by dispatching. Without this, any shared or
    // org-event member could invite more people into a private event via
    // `sharedWith`, flip `isOrgEvent` to expose someone else's private
    // event to the whole org, or end an event out from under its owner —
    // all with a direct Firestore write, no UI needed, since the app's own
    // "only the owner or an admin" buttons are a client-side convenience
    // only and enforce nothing by themselves. The owner and admins are
    // exempt from this restriction — they may still change anything.
    // Delete stays owner/admin-only, same as venues: a shared or org member
    // shouldn't be able to delete someone else's show.
    //
    // TAK bridge accounts (see the TAK block below) never read or write
    // event documents: `!isBridge()` on every operation here.
    match /events/{eventId} {
      allow read: if isEventVisibleToUser() && !isBridge();
      allow create: if request.auth != null && request.resource.data.get('userId', null) == request.auth.uid && !isBridge();
      allow update: if (isEventOwnerOrOrgMember() || isRequestingUserAdmin() ||
        ((isEventSharedWithRequester() || isEventOrgShow()) && isEventProtectedFieldsUnchanged())) && !isBridge();
      allow delete: if (isEventOwnerOrOrgMember() || isRequestingUserAdmin()) && !isBridge();
    }

    // Dispatch logs: owner-scoped, with an admin override for the same
    // account-deletion flow. (No prior rule existed for this collection —
    // added now since admin-initiated deletes need it to actually work.)
    match /dispatchLogs/{logId} {
      allow read, update, delete: if request.auth != null &&
        (resource.data.get('userId', null) == request.auth.uid || isRequestingUserAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Users: allow users to read/write their own profile; admins may also
    // read/write any user's doc (needed to grant/revoke isAdmin from the
    // Profile > Admin > Manage Admins panel).
    //
    // `isAdmin` is carved out of a self-write: without this, any signed-in
    // user could set `isAdmin: true` on their own doc directly via Firestore
    // (the Profile > Admin panel's own "self or admin" button gating is a
    // client-side convenience only) and grant themselves full admin rights —
    // including editing or deleting any other user's venues/events, which
    // `isRequestingUserAdmin()` unlocks everywhere else in this file. Only an
    // existing admin may set `isAdmin` on anyone (self included).
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isRequestingUserAdmin());
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('isAdmin', false) == false;
      allow update: if request.auth != null &&
        (
          isRequestingUserAdmin() ||
          (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']))
        );
      allow delete: if request.auth != null &&
        (request.auth.uid == userId || isRequestingUserAdmin());
    }

    // Settings: app-wide admin-managed config (e.g. the certification list
    // offered when adding team members). Readable by any authenticated user
    // since it's needed during event creation; writable only by admins.
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isRequestingUserAdmin();
    }

    // IMPORTANT: dot-notation field access (`doc.data.someField`) THROWS if
    // the field is absent, it does not evaluate to null/false the way it
    // would in JS. An uncaught throw anywhere in an `allow` expression
    // denies the whole request, even branches joined with `||` that would
    // otherwise have granted access (an error, not a boolean, doesn't
    // participate in short-circuiting). Confirmed against the Firestore
    // emulator: `get(...).data.isAdmin == true` threw "Property isAdmin is
    // undefined on object" for any account without that field set, i.e.
    // almost every non-admin user. Every function below that reads a field
    // which may legitimately be absent on a given document uses
    // `Map.get(key, default)` (safe) or the `in` operator (safe presence
    // check) instead of bare dot access.
    function isRequestingUserAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Fallback deny
    function isOrgMember(orgId) {
      // Check members array
      return request.auth != null && (
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', []) is list &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', []).hasAny([request.auth.uid])
        )
        ||
        // or members subcollection
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
      );
    }

    // These all use `resource.data` — the document already being evaluated
    // — rather than an explicit `get()` back on that same path. Firestore
    // binds `resource` for read/update/delete automatically; calling
    // get() on your own path is redundant for a single `get`, and actively
    // broken for a `list` (a collection query): confirmed against the
    // Firestore emulator that a self-referential get() inside a venues/
    // events read rule throws "Null value error. for 'list'" the moment a
    // query (not a single-document read) hits that rule, even though the
    // identical rule works fine for a plain get. That made every list
    // query against venues/events fail outright (e.g. the admin panel's
    // "delete user and their data" flow, which queries events/venues by
    // userId). `resource.data` doesn't have this problem since it's not a
    // get() call at all — it's the value Firestore already looked up to
    // decide whether to run the rule in the first place.
    //
    // Reads require sign-in plus one of the access paths the app offers:
    // owner, listed in `sharedWith`, an instance-wide org venue/event, a
    // member of the doc's `orgId` organization, or a site admin. These used
    // to treat any doc without an `orgId` as public, and since the app never
    // sets `orgId`, that made every venue and event (including call data)
    // readable by anyone holding the public Firebase config, signed in or
    // not. Each branch below matches one of the app's list queries, so
    // Firestore can prove those queries safe: `userId == uid` (owner),
    // `sharedWith array-contains email` (shared), `isOrgVenue/isOrgEvent ==
    // true` (org-wide), `orgId == X`, and admin.
    function isVenueVisibleToUser() {
      return request.auth != null && (
        isVenueOwner() ||
        isVenueSharedWithRequester() ||
        resource.data.get('isOrgVenue', false) == true ||
        ('orgId' in resource.data && resource.data.orgId is string && isOrgMember(resource.data.orgId)) ||
        isRequestingUserAdmin()
      );
    }

    function isEventVisibleToUser() {
      return request.auth != null && (
        isEventOwnerOrOrgMember() ||
        isEventSharedWithRequester() ||
        isEventOrgShow() ||
        isRequestingUserAdmin()
      );
    }

    // Same check as isEventSharedWithRequester below.
    function isVenueSharedWithRequester() {
      return request.auth != null &&
        ('email' in request.auth.token) && request.auth.token.email is string &&
        'sharedWith' in resource.data &&
        request.auth.token.email.lower() in resource.data.sharedWith;
    }

    function isVenueOwner() {
      return request.auth != null && resource.data.get('userId', null) == request.auth.uid;
    }

    function isEventOwnerOrOrgMember() {
      return request.auth != null &&
        (resource.data.get('userId', null) == request.auth.uid ||
          ('orgId' in resource.data && resource.data.orgId is string && isOrgMember(resource.data.orgId)));
    }

    // sharedWith is always written lowercased by the app (see ShareModal),
    // so a lowercased token email is safe to compare directly against it
    // without needing to lowercase every array entry. Written as
    // `'sharedWith' in resource.data && email in sharedWith` rather than
    // `get(...) is list && hasAny([...])`: both are fine for a single-doc
    // read, but Firestore can only prove the selection page's
    // `sharedWith array-contains email` list query safe against this form
    // (confirmed against the emulator, where the hasAny form denied it).
    function isEventSharedWithRequester() {
      return request.auth != null &&
        ('email' in request.auth.token) && request.auth.token.email is string &&
        'sharedWith' in resource.data &&
        request.auth.token.email.lower() in resource.data.sharedWith;
    }

    // isOrgEvent makes a show visible to and dispatchable by every member of
    // this instance (there's no per-organization scoping today — see the
    // orgId comments above), mirroring how isOrgVenue already works.
    function isEventOrgShow() {
      return request.auth != null && resource.data.get('isOrgEvent', false) == true;
    }

    // The event fields a non-owner, non-admin writer (a shared user, or an
    // org member via isEventOrgShow) must not be able to change: who owns
    // the event, who it's shared with, whether it's an org-wide show,
    // whether/when it's ended, and whether it uses TAK (`mapMode`). See the
    // events match block above for why.
    function isEventProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['userId', 'sharedWith', 'isOrgEvent', 'ended', 'endedAt', 'mapMode']);
    }

    // ===================================================================
    // TAK integration (in development, optional). Everything below applies
    // only to TAK collections; see docs/tak-integration/data-contract.md.
    //
    // - Bridge accounts are ordinary Auth users with a bridgeAccounts/{uid}
    //   record, created and managed only by admins. Deleting the record
    //   revokes the bridge, since every bridge rule checks it.
    // - A bridge reads only its events' takConfig and takDeviceLinks, and
    //   writes only takLive, takHistory, takStatus and its own status. It
    //   never reads event documents (see the events rules above).
    // - A bridge account can't create or edit bridge records, TAK config,
    //   map alignment, device links or device mappings.
    // - An event owner can link a bridge only if they are in its
    //   allowedUsers.
    // ===================================================================

    match /bridgeAccounts/{bridgeUid} {
      // Written as `'allowedUsers' in ... && uid in ...` so Firestore can
      // prove the event-creation query (allowedUsers array-contains uid).
      allow read: if request.auth != null && (
        request.auth.uid == bridgeUid ||
        ('allowedUsers' in resource.data && request.auth.uid in resource.data.allowedUsers) ||
        isRequestingUserAdmin()
      );
      allow create: if isRequestingUserAdmin() && !isBridge() &&
        bridgeUid != request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidBridgeAccount(request.resource.data);
      allow update: if isRequestingUserAdmin() && !isBridge() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        isValidBridgeAccount(request.resource.data);
      allow delete: if isRequestingUserAdmin() && !isBridge();

      // Remembered device-to-team-name mappings. Admins manage them; allowed
      // users add and update them when they link a device by hand.
      match /deviceMappings/{deviceUid} {
        allow read: if isRequestingUserAdmin() || isAllowedBridgeUser(bridgeUid);
        allow create, update: if !isBridge() &&
          (isRequestingUserAdmin() || isAllowedBridgeUser(bridgeUid)) &&
          request.resource.data.keys().hasOnly(['teamName', 'callsign', 'updatedAt', 'updatedBy']) &&
          request.resource.data.teamName is string &&
          request.resource.data.updatedBy == request.auth.uid;
        allow delete: if !isBridge() && isRequestingUserAdmin();
      }

      // Heartbeat, written by the bridge itself.
      match /status/{docId} {
        allow read: if request.auth != null &&
          (request.auth.uid == bridgeUid || isRequestingUserAdmin() || isAllowedBridgeUser(bridgeUid));
        allow write: if docId == 'current' && request.auth != null &&
          request.auth.uid == bridgeUid && isBridge();
      }
    }

    match /events/{eventId}/takConfig/{docId} {
      allow read: if canReadEventData(eventId) ||
        (isBridge() && resource.data.get('bridgeUid', null) == request.auth.uid);
      // The owner manages the config; linking a bridge needs allowedUsers.
      // An admin may only mark it closed (the end-event flow).
      allow create, update: if docId == 'current' && !isBridge() &&
        isValidTakConfig(eventId, request.resource.data) && (
          (isEventOwner(eventId) && isBridgeLinkAllowed()) ||
          (isRequestingUserAdmin() && resource != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'updatedAt']))
        );
      allow delete: if !isBridge() && isEventOwner(eventId);
    }

    // The bridge finds its events with a collection-group query on
    // takConfig where bridgeUid == its uid.
    match /{path=**}/takConfig/{docId} {
      allow read: if isBridge() && resource.data.bridgeUid == request.auth.uid;
    }

    // Map alignment for the TAK overlay and heat maps. Never read by the
    // bridge, which works only in lat/lon.
    match /events/{eventId}/takMapAlignment/{layerId} {
      allow read: if canReadEventData(eventId);
      allow write: if !isBridge() && isEventOwner(eventId);
    }

    // Device -> team links, made by dispatchers. The bridge only reads them.
    match /events/{eventId}/takDeviceLinks/{deviceUid} {
      allow read: if canReadEventData(eventId) || isLinkedBridge(eventId);
      allow create, update: if !isBridge() && canReadEventData(eventId) &&
        request.resource.data.keys().hasOnly(['teamId', 'linkedAt', 'method', 'linkedBy']) &&
        request.resource.data.teamId is string &&
        request.resource.data.method in ['auto', 'manual'] &&
        request.resource.data.linkedBy == request.auth.uid;
      allow delete: if !isBridge() && canReadEventData(eventId);
    }

    // Live device positions, one doc per device, overwritten by the bridge.
    match /events/{eventId}/takLive/{deviceUid} {
      allow read: if canReadEventData(eventId) || isLinkedBridge(eventId);
      allow create, update: if canBridgeWrite(eventId) && isValidLivePosition(request.resource.data);
      // The bridge clears live docs at close (even after closed is set);
      // the owner may clear them when unlinking.
      allow delete: if isLinkedBridge(eventId) || (!isBridge() && isEventOwner(eventId));
    }

    // Location history: owner-only in v1. Unlike live positions, history may
    // still be written after the event closes, so the bridge can flush and
    // end its open segments at close.
    match /events/{eventId}/takHistory/{segmentId} {
      allow read: if (!isBridge() && isEventOwner(eventId)) || isLinkedBridge(eventId);
      allow create, update: if canBridgeWriteHistory(eventId) && historyMode(eventId) != 'off' &&
        request.resource.data.bridgeUid == request.auth.uid;
      allow delete: if !isBridge() && isEventOwner(eventId);

      match /points/{chunkId} {
        allow read: if (!isBridge() && isEventOwner(eventId)) || isLinkedBridge(eventId);
        allow create, update: if canBridgeWriteHistory(eventId) && historyMode(eventId) == 'detailed';
        allow delete: if !isBridge() && isEventOwner(eventId);
      }
    }

    // Which teams are on a call, as opaque team ids only, published by the
    // dispatchers' browsers so the bridge can keep Detailed history during
    // calls without reading the event. No call details.
    match /events/{eventId}/takCallState/{docId} {
      allow read: if canReadEventData(eventId) || isLinkedBridge(eventId);
      allow write: if docId == 'current' && !isBridge() && canReadEventData(eventId) &&
        request.resource.data.keys().hasOnly(['teamIdsOnCall', 'updatedAt']) &&
        request.resource.data.teamIdsOnCall is list && request.resource.data.updatedAt is number;
    }

    // Per-event bridge status, for the event's TAK panel.
    match /events/{eventId}/takStatus/{docId} {
      allow read: if canReadEventData(eventId);
      allow write: if docId == 'current' && isLinkedBridge(eventId);
    }

    function isBridge() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/bridgeAccounts/$(request.auth.uid));
    }

    function isAllowedBridgeUser(bridgeUid) {
      return request.auth != null && !isBridge() &&
        exists(/databases/$(database)/documents/bridgeAccounts/$(bridgeUid)) &&
        request.auth.uid in get(/databases/$(database)/documents/bridgeAccounts/$(bridgeUid)).data.get('allowedUsers', []);
    }

    function isValidBridgeAccount(data) {
      return data.keys().hasOnly(['label', 'createdBy', 'allowedUsers', 'defaultHistoryMode', 'createdAt', 'updatedAt']) &&
        data.label is string && data.allowedUsers is list &&
        data.defaultHistoryMode in ['off', 'summary', 'detailed'];
    }

    // The event's data, through a get() on the parent document. Used by the
    // TAK subcollections, where `resource` is the subcollection doc.
    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isEventOwner(eventId) {
      return request.auth != null && eventDoc(eventId).get('userId', null) == request.auth.uid;
    }

    // Same access paths as isEventVisibleToUser, which is also everyone who
    // may dispatch the event.
    function canReadEventData(eventId) {
      let d = eventDoc(eventId);
      return request.auth != null && !isBridge() && (
        d.get('userId', null) == request.auth.uid ||
        ('orgId' in d && d.orgId is string && isOrgMember(d.orgId)) ||
        (('email' in request.auth.token) && request.auth.token.email is string &&
          request.auth.token.email.lower() in d.get('sharedWith', [])) ||
        d.get('isOrgEvent', false) == true ||
        isRequestingUserAdmin()
      );
    }

    function takConfigDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/takConfig/current).data;
    }

    function isLinkedBridge(eventId) {
      return isBridge() &&
        exists(/databases/$(database)/documents/events/$(eventId)/takConfig/current) &&
        takConfigDoc(eventId).get('bridgeUid', null) == request.auth.uid;
    }

    function canBridgeWrite(eventId) {
      let cfg = takConfigDoc(eventId);
      return isLinkedBridge(eventId) && cfg.get('enabled', false) == true && cfg.get('closed', false) != true;
    }

    function canBridgeWriteHistory(eventId) {
      return isLinkedBridge(eventId) && takConfigDoc(eventId).get('enabled', false) == true;
    }

    function historyMode(eventId) {
      return takConfigDoc(eventId).get('historyMode', 'off');
    }

    function isValidTakConfig(eventId, data) {
      return data.keys().hasOnly(['eventId', 'bridgeUid', 'enabled', 'closed', 'historyMode', 'updatedAt']) &&
        data.eventId == eventId &&
        data.enabled is bool && data.closed is bool &&
        data.historyMode in ['off', 'summary', 'detailed'];
    }

    // Linking: unchanged or cleared links are fine; a new bridgeUid must be
    // one the owner is allowed to use.
    function isBridgeLinkAllowed() {
      let next = request.resource.data.get('bridgeUid', null);
      return next == null ||
        (resource != null && resource.data.get('bridgeUid', null) == next) ||
        isAllowedBridgeUser(next);
    }

    function isValidLivePosition(data) {
      return data.keys().hasOnly(['lat', 'lon', 'hae', 'ce', 'course', 'speed', 'callsign', 'cotType', 'deviceTime', 'receivedAt', 'bridgeUid']) &&
        data.bridgeUid == request.auth.uid &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lon is number && data.lon >= -180 && data.lon <= 180 &&
        data.deviceTime is number && data.receivedAt is number;
    }
  }
}
