rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organizations: allow read for members, create for authenticated users,
    // update/delete only by existing members (ideally owners). This rule
    // assumes organizations doc may have either:
    // - `members` array of uids (existing code), and/or
    // - `members/{uid}` subcollection documents (optional future model).
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if request.auth != null && request.resource.data.get('members', null) is list && request.resource.data.members.hasAny([request.auth.uid]);
      allow update, delete: if isOrgMember(orgId);

      // Allow reading membership subdocs if member
      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update, delete: if isOrgMember(orgId);
      }
    }

    // Venues: creating one needs no permission beyond being signed in — the
    // real app never sets `orgId` on a venue at all (confirmed: it does not
    // appear anywhere in core/src), so requiring `orgId is string` and org
    // membership here, as this rule did until now, made venue creation
    // impossible for every real user the moment these rules were actually
    // deployed to production (they never had been before). The one thing
    // required is that you can only create a venue naming yourself as its
    // owner, not someone else. Reading a venue requires being signed in and
    // having one of the access paths the app itself offers (see
    // isVenueVisibleToUser). Only the venue's creator or a site admin can
    // update, share, or delete it; org membership alone is not enough (a
    // non-admin org member should not be able to edit or delete another
    // member's venue). Admins may update/delete any venue (also needed to
    // wipe a deleted user's data from Profile > Admin > Manage
    // Administrator Access).
    match /venues/{venueId} {
      allow read: if isVenueVisibleToUser();
      allow create: if request.auth != null && request.resource.data.get('userId', null) == request.auth.uid;
      allow update, delete: if isVenueOwner() || isRequestingUserAdmin();
    }

    // Events: same reasoning as venues above — the app never sets `orgId`
    // on an event either, so requiring it on create made event creation
    // impossible too. Creating one just requires being signed in and
    // naming yourself as the owner. Admins may also update/delete any event
    // (see venues comment above).
    //
    // Update is intentionally broader than delete: dispatching a show *is*
    // writing to the event doc (assigning teams, changing call status,
    // posting equipment, etc.), so anyone the app actually lets into the
    // dispatch view — the owner, a user in `sharedWith`, or any member when
    // the event is flagged `isOrgEvent` — needs write access too, not just
    // read. Without this, the dispatch page's client-side check (which
    // already accounts for sharedWith/isOrgEvent) would let a member in but
    // every dispatch action would then fail with permission-denied.
    //
    // That broad grant is field-limited for a non-owner, non-admin writer
    // (a shared user or an org member riding `isOrgEvent`): they can touch
    // ordinary dispatch fields, but not `userId`, `sharedWith`, `isOrgEvent`,
    // `ended`, or `endedAt` (see isEventProtectedFieldsUnchanged) — those
    // control who owns, can see, or can end the event, and none of them are
    // ever legitimately written by dispatching. Without this, any shared or
    // org-event member could invite more people into a private event via
    // `sharedWith`, flip `isOrgEvent` to expose someone else's private
    // event to the whole org, or end an event out from under its owner —
    // all with a direct Firestore write, no UI needed, since the app's own
    // "only the owner or an admin" buttons are a client-side convenience
    // only and enforce nothing by themselves. The owner and admins are
    // exempt from this restriction — they may still change anything.
    // Delete stays owner/admin-only, same as venues: a shared or org member
    // shouldn't be able to delete someone else's show.
    match /events/{eventId} {
      allow read: if isEventVisibleToUser();
      allow create: if request.auth != null && request.resource.data.get('userId', null) == request.auth.uid;
      allow update: if isEventOwnerOrOrgMember() || isRequestingUserAdmin() ||
        ((isEventSharedWithRequester() || isEventOrgShow()) && isEventProtectedFieldsUnchanged());
      allow delete: if isEventOwnerOrOrgMember() || isRequestingUserAdmin();
    }

    // Dispatch logs: owner-scoped, with an admin override for the same
    // account-deletion flow. (No prior rule existed for this collection —
    // added now since admin-initiated deletes need it to actually work.)
    match /dispatchLogs/{logId} {
      allow read, update, delete: if request.auth != null &&
        (resource.data.get('userId', null) == request.auth.uid || isRequestingUserAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Users: allow users to read/write their own profile; admins may also
    // read/write any user's doc (needed to grant/revoke isAdmin from the
    // Profile > Admin > Manage Admins panel).
    //
    // `isAdmin` is carved out of a self-write: without this, any signed-in
    // user could set `isAdmin: true` on their own doc directly via Firestore
    // (the Profile > Admin panel's own "self or admin" button gating is a
    // client-side convenience only) and grant themselves full admin rights —
    // including editing or deleting any other user's venues/events, which
    // `isRequestingUserAdmin()` unlocks everywhere else in this file. Only an
    // existing admin may set `isAdmin` on anyone (self included).
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isRequestingUserAdmin());
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('isAdmin', false) == false;
      allow update: if request.auth != null &&
        (
          isRequestingUserAdmin() ||
          (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']))
        );
      allow delete: if request.auth != null &&
        (request.auth.uid == userId || isRequestingUserAdmin());
    }

    // Settings: app-wide admin-managed config (e.g. the certification list
    // offered when adding team members). Readable by any authenticated user
    // since it's needed during event creation; writable only by admins.
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isRequestingUserAdmin();
    }

    // IMPORTANT: dot-notation field access (`doc.data.someField`) THROWS if
    // the field is absent, it does not evaluate to null/false the way it
    // would in JS. An uncaught throw anywhere in an `allow` expression
    // denies the whole request, even branches joined with `||` that would
    // otherwise have granted access (an error, not a boolean, doesn't
    // participate in short-circuiting). Confirmed against the Firestore
    // emulator: `get(...).data.isAdmin == true` threw "Property isAdmin is
    // undefined on object" for any account without that field set, i.e.
    // almost every non-admin user. Every function below that reads a field
    // which may legitimately be absent on a given document uses
    // `Map.get(key, default)` (safe) or the `in` operator (safe presence
    // check) instead of bare dot access.
    function isRequestingUserAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Fallback deny
    function isOrgMember(orgId) {
      // Check members array
      return request.auth != null && (
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', []) is list &&
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', []).hasAny([request.auth.uid])
        )
        ||
        // or members subcollection
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
      );
    }

    // These all use `resource.data` — the document already being evaluated
    // — rather than an explicit `get()` back on that same path. Firestore
    // binds `resource` for read/update/delete automatically; calling
    // get() on your own path is redundant for a single `get`, and actively
    // broken for a `list` (a collection query): confirmed against the
    // Firestore emulator that a self-referential get() inside a venues/
    // events read rule throws "Null value error. for 'list'" the moment a
    // query (not a single-document read) hits that rule, even though the
    // identical rule works fine for a plain get. That made every list
    // query against venues/events fail outright (e.g. the admin panel's
    // "delete user and their data" flow, which queries events/venues by
    // userId). `resource.data` doesn't have this problem since it's not a
    // get() call at all — it's the value Firestore already looked up to
    // decide whether to run the rule in the first place.
    //
    // Reads require sign-in plus one of the access paths the app offers:
    // owner, listed in `sharedWith`, an instance-wide org venue/event, a
    // member of the doc's `orgId` organization, or a site admin. These used
    // to treat any doc without an `orgId` as public, and since the app never
    // sets `orgId`, that made every venue and event (including call data)
    // readable by anyone holding the public Firebase config, signed in or
    // not. Each branch below matches one of the app's list queries, so
    // Firestore can prove those queries safe: `userId == uid` (owner),
    // `sharedWith array-contains email` (shared), `isOrgVenue/isOrgEvent ==
    // true` (org-wide), `orgId == X`, and admin.
    function isVenueVisibleToUser() {
      return request.auth != null && (
        isVenueOwner() ||
        isVenueSharedWithRequester() ||
        resource.data.get('isOrgVenue', false) == true ||
        ('orgId' in resource.data && resource.data.orgId is string && isOrgMember(resource.data.orgId)) ||
        isRequestingUserAdmin()
      );
    }

    function isEventVisibleToUser() {
      return request.auth != null && (
        isEventOwnerOrOrgMember() ||
        isEventSharedWithRequester() ||
        isEventOrgShow() ||
        isRequestingUserAdmin()
      );
    }

    // Same check as isEventSharedWithRequester below.
    function isVenueSharedWithRequester() {
      return request.auth != null &&
        ('email' in request.auth.token) && request.auth.token.email is string &&
        'sharedWith' in resource.data &&
        request.auth.token.email.lower() in resource.data.sharedWith;
    }

    function isVenueOwner() {
      return request.auth != null && resource.data.get('userId', null) == request.auth.uid;
    }

    function isEventOwnerOrOrgMember() {
      return request.auth != null &&
        (resource.data.get('userId', null) == request.auth.uid ||
          ('orgId' in resource.data && resource.data.orgId is string && isOrgMember(resource.data.orgId)));
    }

    // sharedWith is always written lowercased by the app (see ShareModal),
    // so a lowercased token email is safe to compare directly against it
    // without needing to lowercase every array entry. Written as
    // `'sharedWith' in resource.data && email in sharedWith` rather than
    // `get(...) is list && hasAny([...])`: both are fine for a single-doc
    // read, but Firestore can only prove the selection page's
    // `sharedWith array-contains email` list query safe against this form
    // (confirmed against the emulator, where the hasAny form denied it).
    function isEventSharedWithRequester() {
      return request.auth != null &&
        ('email' in request.auth.token) && request.auth.token.email is string &&
        'sharedWith' in resource.data &&
        request.auth.token.email.lower() in resource.data.sharedWith;
    }

    // isOrgEvent makes a show visible to and dispatchable by every member of
    // this instance (there's no per-organization scoping today — see the
    // orgId comments above), mirroring how isOrgVenue already works.
    function isEventOrgShow() {
      return request.auth != null && resource.data.get('isOrgEvent', false) == true;
    }

    // The event fields a non-owner, non-admin writer (a shared user, or an
    // org member via isEventOrgShow) must not be able to change: who owns
    // the event, who it's shared with, whether it's an org-wide show, and
    // whether/when it's ended. See the events match block above for why.
    function isEventProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['userId', 'sharedWith', 'isOrgEvent', 'ended', 'endedAt']);
    }
  }
}
