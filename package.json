{
  "name": "dispatch-app",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-crowdcad \"node tests/rules/run.mjs\"",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:pocketbase": "bddgen --config playwright.config.pocketbase.ts && playwright test --config playwright.config.pocketbase.ts",
    "test:e2e:serve": "concurrently --names \"emulator,nextjs\" --kill-others-on-fail \"npx firebase emulators:start --only auth,firestore --project demo-crowdcad\" \"cross-env NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=true NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-crowdcad NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-crowdcad.appspot.com NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000 NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:fake next dev\""
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tailwindcss/postcss": "^4.3.5",
    "barcode-detector": "3.2.4",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.5.1",
    "framer-motion": "^14.14.0",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "next-nprogress-bar": "^2.4.7",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.7.1",
    "pocketbase": "^0.29.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-img-mapper": "^2.0.2",
    "react-resizable-panels": "^3.0.6",
    "react-toastify": "^11.2.0",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "uqr": "0.1.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@types/kill-port": "^2.0.3",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "20.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "daisyui": "^5.8.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "firebase-tools": "^15.37.0",
    "kill-port": "^2.0.1",
    "playwright-bdd": "^9.2.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@internationalized/date": "^3.12.4",
    "picomatch@4": "^4.0.4",
    "postcss": "$postcss"
  }
}
