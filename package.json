{
  "name": "dispatch-app",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:pocketbase": "bddgen --config playwright.config.pocketbase.ts && playwright test --config playwright.config.pocketbase.ts",
    "test:e2e:serve": "concurrently --names \"emulator,nextjs\" --kill-others-on-fail \"npx firebase emulators:start --only auth,firestore --project demo-crowdcad\" \"cross-env NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=true NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-crowdcad NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-crowdcad.appspot.com NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000 NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:fake next dev\""
  },
  "dependencies": {
    "@heroui/react": "^2.8.5",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.43.0",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "next": "^15.5.23",
    "next-nprogress-bar": "^2.4.7",
    "nodemailer": "^7.0.5",
    "papaparse": "^5.6.0",
    "pocketbase": "^0.26.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-img-mapper": "^2.0.2",
    "react-resizable-panels": "^3.0.6",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.58.2",
    "@types/kill-port": "^2.0.3",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "20.19.1",
    "@types/nodemailer": "^7.0.12",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.20",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "firebase-tools": "^15.28.1",
    "kill-port": "^2.0.1",
    "playwright-bdd": "^8.5.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
